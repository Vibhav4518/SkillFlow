generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  createdAt        DateTime          @default(now())
  fullName         String
  passwordHash     String
  updatedAt        DateTime          @updatedAt
  role             Role              @default(CANDIDATE)
  bookmarks        Bookmark[]
  candidateProfile CandidateProfile?
  companyReviews   CompanyReview[]
  employerProfile  EmployerProfile?
  notifications    Notification[]
  refresh_tokens   RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model CandidateProfile {
  id                 String                   @id @default(uuid())
  headline           String?
  summary            String?
  phone              String?
  location           String?
  createdAt          DateTime                 @default(now())
  experienceYears    Int?
  githubUrl          String?
  linkedinUrl        String?
  portfolioUrl       String?
  preferredWorkType  WorkType?
  profilePhotoUrl    String?
  resumeFileSize     Int?
  resumeOriginalName String?
  resumeUploadedAt   DateTime?
  resumeUrl          String?
  updatedAt          DateTime                 @updatedAt
  userId             String                   @unique
  certifications     CandidateCertification[]
  education          Education[]
  experiences        CandidateExperience[]
  languages          CandidateLanguage[]
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects           CandidateProject[]
  skills             CandidateSkill[]
  applications       JobApplication[]

  @@map("candidate_profiles")
}

model Education {
  id           String           @id @default(uuid())
  candidateId  String
  degree       String
  institution  String
  fieldOfStudy String?
  startYear    Int?
  endYear      Int?
  grade        String?
  gradeType    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_education")
}

model Skill {
  id              String           @id @default(uuid())
  name            String           @unique
  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]

  @@map("skills")
}

model CandidateSkill {
  candidateId String
  skillId     String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateId, skillId])
  @@map("candidate_skills")
}

model CandidateLanguage {
  id          String           @id @default(uuid())
  candidateId String
  language    String
  canRead     Boolean          @default(false)
  canWrite    Boolean          @default(false)
  canSpeak    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_languages")
}

model CandidateExperience {
  id           String           @id @default(uuid())
  candidateId  String
  type         ExperienceType
  companyName  String
  designation  String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  technologies String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_experiences")
}

model CandidateProject {
  id           String           @id @default(uuid())
  candidateId  String
  name         String
  description  String?
  technologies String?
  startDate    DateTime?
  endDate      DateTime?
  githubUrl    String?
  liveUrl      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_projects")
}

model CandidateCertification {
  id                  String           @id @default(uuid())
  candidateId         String
  name                String
  issuingOrganization String?
  issueDate           DateTime?
  credentialUrl       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  candidate           CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_certifications")
}

model Company {
  id                       String             @id @default(uuid())
  name                     String
  description              String?
  location                 String?
  companySize              String?
  createdAt                DateTime           @default(now())
  deletedAt                DateTime?
  logoUrl                  String?
  updatedAt                DateTime           @updatedAt
  verificationStatus       VerificationStatus @default(PENDING)
  websiteUrl               String?
  industry                 String?
  verificationDocumentsUrl String?
  rejectionReason          String?
  reviews                  CompanyReview[]
  employers                EmployerProfile[]
  jobs                     Job[]

  @@map("companies")
}

model EmployerProfile {
  id              String   @id @default(uuid())
  designation     String?
  phone           String?
  companyId       String
  createdAt       DateTime @default(now())
  department      String?
  profilePhotoUrl String?
  updatedAt       DateTime @updatedAt
  userId          String   @unique
  isActive        Boolean  @default(true)
  isVerified      Boolean  @default(false)
  company         Company  @relation(fields: [companyId], references: [id])
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs            Job[]

  @@index([companyId])
  @@map("employer_profiles")
}

model JobCategory {
  id   String @id @default(uuid())
  name String @unique
  jobs Job[]

  @@map("job_categories")
}

model Job {
  id                  String           @id @default(uuid())
  title               String
  description         String
  location            String?
  vacancies           Int?
  applicationDeadline DateTime?
  categoryId          String?
  companyId           String
  createdAt           DateTime         @default(now())
  createdByEmployerId String
  deletedAt           DateTime?
  experienceMax       Int?
  experienceMin       Int?
  isPromoted          Boolean          @default(false)
  isSalaryVisible     Boolean          @default(true)
  jobType             JobType?
  promotionEndAt      DateTime?
  promotionPaymentId  String?
  promotionStartAt    DateTime?
  promotionType       PromotionType?
  publishedAt         DateTime?
  salaryMax           Int?
  salaryMin           Int?
  updatedAt           DateTime         @updatedAt
  workType            WorkType?
  status              JobStatus        @default(DRAFT)
  rejectionReason     String?
  bookmarks           Bookmark[]
  applications        JobApplication[]
  skills              JobSkill[]
  category            JobCategory?     @relation(fields: [categoryId], references: [id])
  company             Company          @relation(fields: [companyId], references: [id])
  createdByEmployer   EmployerProfile  @relation(fields: [createdByEmployerId], references: [id])

  @@index([companyId])
  @@index([createdByEmployerId])
  @@index([categoryId])
  @@map("jobs")
}

model JobSkill {
  jobId   String
  skillId String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

model JobApplication {
  id              String                     @id @default(uuid())
  appliedAt       DateTime                   @default(now())
  candidateId     String
  coverLetter     String?
  resumeUrl       String?
  jobId           String
  statusUpdatedAt DateTime?
  updatedAt       DateTime                   @updatedAt
  withdrawnAt     DateTime?
  status          ApplicationStatus          @default(APPLIED)
  statusHistory   ApplicationStatusHistory[]
  bookmarks       Bookmark[]
  candidate       CandidateProfile           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job             Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([candidateId])
  @@map("job_applications")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  changedByRole Role?
  reason        String?
  automated     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  application   JobApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_status_history")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  createdAt DateTime @default(now())
  metadata  Json?
  read      Boolean  @default(false)
  type      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model ContactMessage {
  id        String               @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@map("contact_messages")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@map("audit_logs")
}

model CompanyReview {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  rating    Int      @default(5)
  title     String?
  review    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@map("company_reviews")
}

model Bookmark {
  id            String          @id @default(uuid())
  userId        String
  jobId         String?
  applicationId String?
  type          BookmarkType    @default(JOB)
  createdAt     DateTime        @default(now())
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  job           Job?            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@unique([userId, applicationId])
  @@index([userId])
  @@map("bookmarks")
}

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
  COMPANY_ADMIN
}

enum WorkType {
  REMOTE
  ONSITE
  HYBRID
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  APPROVED
  SUSPENDED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ExperienceType {
  INTERNSHIP
  EXPERIENCE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  EXPIRED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PromotionType {
  FEATURED
  URGENT
  HIGHLIGHTED
}

enum ApplicationStatus {
  APPLIED
  IN_PROGRESS
  REJECTED
  SELECTED
  SHORTLISTED
  INTERVIEW
  WITHDRAWN
}

enum ContactMessageStatus {
  NEW
  READ
  RESOLVED
}

enum BookmarkType {
  JOB
  APPLICATION
}
